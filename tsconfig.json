// The type check for the tests, their config and the command-line tools under tools/: strict TypeScript on
// Node, no emit. The site's browser scripts and the Worker have their own (tsconfig.site.json,
// tsconfig.worker.json), each against its own runtime's library; `npm run typecheck` runs all three. It
// reads JavaScript too, so a test of a site module (site/inbox/markdown.js) gets that module's JSDoc types.
{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["test/**/*.ts", "tools/**/*.ts", "vitest.config.ts"]
}
